{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentCanvas",
  "version": "1.0.0",
  "identifier": "ai.agentcanvas.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "Image and poster engine agents can drive",
    "longDescription": "Native design and image-processing app with the same surface exposed over HTTP, MCP and CLI.",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      },
      "wix": { "language": ["zh-CN", "en-US"] }
    },
    "resources": [],
    "externalBin": []
  }
}
